#!/usr/bin/env php
<?php

declare(strict_types=1);

use Svnjn\Standards\Console\StreamOutput;
use Svnjn\Standards\Link\LinkCommand;
use Svnjn\Standards\Link\Linker;
use Svnjn\Standards\Process\SymfonyProcessRunner;

require $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

$output = new StreamOutput();
$command = new LinkCommand(new Linker(new SymfonyProcessRunner(), $output, getenv('COMPOSER_BINARY') ?: 'composer'), $output, (string) getcwd());

exit($command->link(array_values(array_slice($argv, 1))));
